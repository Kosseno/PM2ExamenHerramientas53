<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_herramienta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/img_herramienta_item"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lbl_nombre_herramienta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre de la Herramienta"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lbl_estado_herramienta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado: --"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/lbl_tecnico_herramienta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Técnico: --"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/lbl_fecha_fin_herramienta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Entrega: --"
                android:layout_marginTop="4dp"/>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>